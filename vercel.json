{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @autional/trust-center... build",
  "outputDirectory": "apps/trust-center/dist",
  "rewrites": [
    {
      "source": "/bff/:path*",
      "destination": "https://api.autional.cn/bff/:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://api.autional.cn/api/v1/:path*"
    },
    {
      "source": "/oauth/:path*",
      "destination": "https://api.autional.cn/oauth/:path*"
    },
    {
      "source": "/tenant/:path*",
      "destination": "https://api.autional.cn/tenant/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
